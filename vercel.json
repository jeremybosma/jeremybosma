{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/api/markdown?path=/"
    },
    {
      "source": "/about",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/api/markdown?path=/about"
    },
    {
      "source": "/contact",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/api/markdown?path=/contact"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/api/markdown?path=/privacy"
    },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/agency", "destination": "/agency.html" },
    { "source": "/site/:slug", "destination": "/site/:slug.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/music", "destination": "/music.html" },
    { "source": "/music/:slug", "destination": "/music/:slug.html" },
    { "source": "/videos", "destination": "/videos.html" },
    { "source": "/writing", "destination": "/writing.html" },
    { "source": "/writing/:slug", "destination": "/writing/:slug.html" },
    { "source": "/supply", "destination": "/supply.html" },
    { "source": "/supply/:id", "destination": "/supply/:id.html" }
  ]
}
